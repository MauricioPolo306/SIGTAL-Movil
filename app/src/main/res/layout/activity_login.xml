<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F6FA"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Encabezado de SIGTAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="SIGTAL"
            android:textColor="#17365D"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Sistema Integral de Gestión para Taller Automotriz Londoño"
            android:textColor="#526174"
            android:textSize="15sp" />

        <!-- Título del formulario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:gravity="center"
            android:text="Iniciar sesión"
            android:textColor="#17365D"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Ingresa tus credenciales para continuar"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Tarjeta del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textColor="#243447"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUsuarioLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="username"
                android:hint="Ingresa tu usuario"
                android:inputType="text"
                android:maxLines="1"
                android:padding="14dp"
                android:selectAllOnFocus="true"
                android:textColor="#172033"
                android:textColorHint="#8793A3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Contraseña"
                android:textColor="#243447"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtContrasenaLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="password"
                android:hint="Ingresa tu contraseña"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="14dp"
                android:textColor="#172033"
                android:textColorHint="#8793A3" />

            <!-- Recuperación de contraseña -->

            <TextView
                android:id="@+id/txtOlvideContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="44dp"
                android:gravity="end|center_vertical"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#1769AA"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />


            <!-- Botón de ingreso -->
            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#17365D"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Cuentas de demostración -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="#526174"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <!-- Pie de página -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="SIGTAL © 2026"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
